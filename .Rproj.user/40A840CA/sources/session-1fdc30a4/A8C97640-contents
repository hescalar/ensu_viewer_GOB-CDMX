#Tablas resumen


## 1. Obtener los promedios de campaña desde df_campaña
promedios_campaña <- df_campaña %>%
  filter(grepl("Promedio", as_label(cons_emp), ignore.case = TRUE)) %>%
  mutate(intencion_formateada = sprintf("%.1f%%", intencion*100)) %>%
  select(candidat, "Promedio campaña" = intencion_formateada)

## 2. Preparar datos de fechas
fechas_levantamiento <- df_long %>%
  filter(!grepl("Promedio", as_label(cons_emp), ignore.case = TRUE)) %>%
  distinct(id, cons_emp, fecha_fin) %>%
  mutate(
    Consultora = paste(id, ". ", as_label(cons_emp)),
    Fecha = format(fecha_fin, "%d/%m/%Y")
  ) %>%
  select(Consultora, Fecha) %>%
  pivot_wider(
    names_from = Consultora,
    values_from = Fecha
  ) %>%
  mutate(candidat = "Fecha levantamiento",
         "Promedio campaña" = "--") %>%
  select(candidat, everything(), "Promedio campaña")

## 3. Preparar y ordenar datos de intención
datos_intencion <- df_long %>%
  filter(!grepl("Promedio", as_label(cons_emp), ignore.case = TRUE) )%>%
           mutate(
             Consultora = paste(id, ". ", as_label(cons_emp)),
             candidato = factor(candidat, levels = unique(dictionary$descr_etiquetas)),
             intencion_formateada = ifelse(is.na(intencion), "--", sprintf("%.1f%%", intencion*100))
           ) %>%
           select(Consultora, candidat, intencion_formateada) %>%
           pivot_wider(
             names_from = Consultora,
             values_from = intencion_formateada
           ) %>%
           left_join(promedios_campaña, by = "candidat") %>%
            # ORDENAMIENTO CORREGIDO (usa backticks para nombres con espacios)
            arrange(desc(readr::parse_number(gsub("%", "", `Promedio campaña`))))


## 3. Preparar y ordenar datos de intención (VERSIÓN FINAL)
datos_intencion <- df_long %>%
  filter(!grepl("Promedio", as_label(cons_emp), ignore.case = TRUE)) %>%
           mutate(
             Consultora = paste(id,". ", as_label(cons_emp)),
             candidato = factor(candidat, levels = unique(dictionary$descr_etiquetas)),
             intencion_formateada = ifelse(is.na(intencion), "--", sprintf("%.1f%%", intencion*100)),
             # Crear categoría para ordenamiento especial
             orden_custom = case_when(
               candidat %in% c("Blancos", "Nulos", "Indecisos") ~ 2,
               TRUE ~ 1
             )
           ) %>%
           select(Consultora, candidat, intencion_formateada, orden_custom) %>%
           pivot_wider(
             names_from = Consultora,
             values_from = intencion_formateada
           ) %>%
           left_join(promedios_campaña, by = "candidat") %>%
           # Ordenar primero por categoría custom, luego por promedio
           arrange(orden_custom, desc(readr::parse_number(gsub("%", "", `Promedio campaña`)))) %>%
           select(-orden_custom)  # Eliminar la columna temporal

## 4. Combinar tablas
tabla_completa <- bind_rows(
  fechas_levantamiento,
  datos_intencion
) %>%
  # Crear tabla GT
  gt() %>%
  tab_header(
