                        BP5_1_1 == "99" ~ NA),
  conf_gob = case_when(BP5_1_2 == "00" | BP5_1_2 == "01" | BP5_1_2 == "02" | BP5_1_2 == "03" ~ "No confía nada (0 a 3)",
                       BP5_1_2 == "04" | BP5_1_2 == "05" ~ "No confía (4 a 5)",
                       BP5_1_2 == "06" | BP5_1_2 == "07" ~ "Confía (6 a 7)",
                       BP5_1_2 == "08" | BP5_1_2 == "09" | BP5_1_2 == "10" ~ "Confía mucho (8 a 10)",
                       BP5_1_2 == "99" ~ NA), 
  conf_alc = case_when(BP5_1_3 == "00" | BP5_1_3 == "01" | BP5_1_3 == "02" | BP5_1_3 == "03" ~ "No confía nada (0 a 3)",
                       BP5_1_3 == "04" | BP5_1_3 == "05" ~ "No confía (4 a 5)",
                       BP5_1_3 == "06" | BP5_1_3 == "07" ~ "Confía (6 a 7)",
                       BP5_1_3 == "08" | BP5_1_3 == "09" | BP5_1_3 == "10" ~ "Confía mucho (8 a 10)",
                       BP5_1_3 == "99" ~ NA)
