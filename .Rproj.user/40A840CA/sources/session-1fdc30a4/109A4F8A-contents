ENSU_CB_0323 <- ENSU_CB_0323 %>% mutate(
  conf_pres = case_when(BP4_1_1 == "00" | BP4_1_1 == "01" | BP4_1_1 == "02" | BP4_1_1 == "03" ~ "No confía nada",
                        BP4_1_1 == "04" | BP4_1_1 == "05" ~ "No confía",
                        BP4_1_1 == "06" | BP4_1_1 == "07" ~ "Confía",
                        BP4_1_1 == "08" | BP4_1_1 == "09" | BP4_1_1 == "10" ~ "Confía mucho",
                        BP4_1_1 == "99" ~ NA),
  conf_gob = case_when(BP4_1_2 == "00" | BP4_1_2 == "01" | BP4_1_2 == "02" | BP4_1_2 == "03" ~ "No confía nada",
                       BP4_1_2 == "04" | BP4_1_2 == "05" ~ "No confía",
                       BP4_1_2 == "06" | BP4_1_2 == "07" ~ "Confía",
                       BP4_1_2 == "08" | BP4_1_2 == "09" | BP4_1_2 == "10" ~ "Confía mucho",
                       BP4_1_2 == "99" ~ NA), 
  conf_alc = case_when(BP4_1_3 == "00" | BP4_1_3 == "01" | BP4_1_3 == "02" | BP4_1_3 == "03" ~ "No confía nada",
                       BP4_1_3 == "04" | BP4_1_3 == "05" ~ "No confía",
                       BP4_1_3 == "06" | BP4_1_3 == "07" ~ "Confía",
                       BP4_1_3 == "08" | BP4_1_3 == "09" | BP4_1_3 == "10" ~ "Confía mucho",
                       BP4_1_3 == "99" ~ NA)
)%>%
  mutate(conf_pres = factor(conf_pres, levels = c("Confía mucho", "Confía", "No confía", "No confía nada")))%>%
  mutate(conf_gob = factor(conf_gob, levels = c("Confía mucho", "Confía", "No confía", "No confía nada")))%>%
  mutate(conf_alc = factor(conf_alc, levels = c("Confía mucho", "Confía", "No confía", "No confía nada")))
  
